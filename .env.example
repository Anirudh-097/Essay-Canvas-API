# Supabase PostgreSQL connection string.
# Get this from Supabase: Connect > Connection string.
# Use the pooled/transaction URL for a hosted app when available.
DATABASE_URL=postgresql://postgres.<project-ref>:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# DATABASE_POOL_MAX_SIZE=5

# Required custom API authentication settings
AUTH_USERNAME=your-username
# Generate with: python auth.py
AUTH_PASSWORD_HASH=pbkdf2_sha256$310000$replace-with-generated-value
# Use a long random value; never commit the real secret.
AUTH_SECRET=replace-with-a-long-random-secret

# Required for essay generation and paragraph evaluation
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Exact frontend origins. Separate multiple origins with commas.
FRONTEND_ORIGINS=http://localhost:3000

# Set this in the Vercel project, not in Render:
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# Vercel and Render are different sites, so cross-site cookies need this.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
